<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ReanDialer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ocean_500</item>
        <item name="colorOnPrimary">@color/ocean_950</item>
        <item name="colorPrimaryContainer">@color/ocean_800</item>
        <item name="colorOnPrimaryContainer">@color/ocean_100</item>
        <item name="colorSecondary">@color/ocean_300</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ocean_950</item>
        <item name="android:navigationBarColor">@color/ocean_950</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.ReanDialer.FullScreen" parent="Theme.ReanDialer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
